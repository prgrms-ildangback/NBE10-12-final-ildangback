# EC2 /opt/team1-app/.env — 최초 1회 수동 배치 (infra-runbook.md 1장). chmod 600. 커밋 금지.
# deploy.sh 는 IMAGE_TAG 만 갱신하고 나머지는 건드리지 않는다.
# 값에 $ ` 따옴표 공백 등 셸 메타문자가 있으면 backup.sh 의 `. .env` 소싱이 깨지므로 피할 것.

# ---- 이미지 ----
GHCR_REPO=prgrms-ildangback/nbe10-12-final-ildangback     # 소문자
IMAGE_TAG=latest                                  # 배포 시 커밋 SHA 로 교체됨

# ---- DB (mysql 컨테이너) ----
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gommit
DB_USERNAME=gommit
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too

# ---- 앱 ----
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET_KEY=change-me-min-32-bytes
CORS_ALLOWED_ORIGINS=https://go-mmit.site

# ---- 미디어 (Cloudinary) ----
MEDIA_STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- 인증 메일 ----
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# ---- 소셜 로그인 ----
OAUTH_ALLOWED_REDIRECT_URIS=https://go-mmit.site/oauth/google/callback,https://go-mmit.site/oauth/naver/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# ---- 모니터링 (Q29, grafana 컨테이너) ----
DOMAIN=go-mmit.site
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
