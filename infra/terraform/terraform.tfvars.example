# cp terraform.tfvars.example terraform.tfvars 후 채운다. terraform.tfvars 는 커밋 금지.

aws_account_id       = "123456789012"
cloudflare_zone_id   = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
cloudflare_api_token = "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# 크레딧 Budget: 계정 생성 월 1일부터 12개월 누적
alert_emails     = ["me@example.com"]
budget_start     = "2026-09-01"
budget_limit_usd = 100
budget_alert_usd = [50, 80]
budget_stop_usd  = 95

# 컷오버 전 테스트: api-next 만, grafana 미생성. 컷오버 때 "api" / "grafana"
# api_subdomain     = "api-next"
# grafana_subdomain = ""

# 구매 후 실제 도메인으로 교체 (기본값 go-mmit.site 는 임시)
# domain = "go-mmit.site"

# GitHub Environment 이름과 일치해야 함 (runbook 1-3)
# deploy_environment = "production"
